flowchart LR
    ROOT["Charts for Agent Productivity Analysis"]

    ROOT --> TRD["1. Trends over Time"]
    TRD --> TRD1["Line chart: daily or weekly volume, AHT, SLA percent"]
    TRD --> TRD2["Area chart: contact volume by queue"]
    TRD --> TRD3["Line with rolling average: smooth noisy metrics"]
    TRD --> TRD4["Control chart: metric stability with upper and lower limits"]

    ROOT --> CMP["2. Comparing Agents and Teams"]
    CMP --> CMP1["Horizontal bar: agent leaderboard"]
    CMP --> CMP2["Grouped bar: team vs team per metric"]
    CMP --> CMP3["Bullet chart: actual vs target per agent"]
    CMP --> CMP4["Radar chart: one agent across 5 to 6 metrics"]
    CMP --> CMP5["Slope chart: agent change month over month"]

    ROOT --> DST["3. Distributions"]
    DST --> DST1["Histogram: AHT and closure time spread"]
    DST --> DST2["Box plot: AHT by agent, team or queue"]
    DST --> DST3["Violin plot: shape of handle time per call type"]
    DST --> DST4["Percentile chart: P50, P90, P95 of closure time"]

    ROOT --> PRT["4. Breakdown and Composition"]
    PRT --> PRT1["Stacked bar: AHT split into talk, hold, ACW"]
    PRT --> PRT2["100 percent stacked bar: call-type mix per queue"]
    PRT --> PRT3["Treemap: case volume by type and subtype"]
    PRT --> PRT4["Pareto chart: few case types causing most time"]
    PRT --> PRT5["Donut: SLA met vs breached, use sparingly"]

    ROOT --> REL["5. Relationships"]
    REL --> REL1["Scatter: AHT vs FCR per agent, speed vs quality"]
    REL --> REL2["Bubble: AHT vs FCR sized by volume"]
    REL --> REL3["Correlation heatmap: all metrics vs each other"]
    REL --> REL4["Scatter with trend line: tenure vs productivity"]

    ROOT --> PAT["6. Time Patterns"]
    PAT --> PAT1["Heatmap: hour x weekday contact volume"]
    PAT --> PAT2["Calendar heatmap: daily SLA breaches over the year"]
    PAT --> PAT3["Heatmap: agent x week performance grid"]

    ROOT --> FLW["7. Flow and Journey"]
    FLW --> FLW1["Funnel: bot to agent to case to closed"]
    FLW --> FLW2["Sankey: intent to handoff reason to queue"]
    FLW --> FLW3["Sankey: transfers between queues"]
    FLW --> FLW4["Waterfall: where total resolution time is spent"]

    ROOT --> BOT["8. Bot Analysis"]
    BOT --> BOT1["Line: containment rate trend"]
    BOT --> BOT2["Bar: top intents with success rate"]
    BOT --> BOT3["Funnel: drop-off by dialog step"]
    BOT --> BOT4["Stacked bar: no-match vs no-input by intent"]

    ROOT --> TXT["9. Case Comments"]
    TXT --> TXT1["Bar: top keywords and phrases"]
    TXT --> TXT2["Histogram: comment length per case"]
    TXT --> TXT3["Scatter: comment count vs closure time"]
    TXT --> TXT4["Word cloud: quick visual only, not for decisions"]

    ROOT --> KPI["10. Dashboard Summary"]
    KPI --> KPI1["KPI tiles with delta vs last period"]
    KPI --> KPI2["Sparklines beside each KPI"]
    KPI --> KPI3["Gauge: SLA attainment vs target"]
    KPI --> KPI4["Table with conditional colour: agent drill-down"]

    ROOT --> DQ["11. Data Quality"]
    DQ --> DQ1["Bar: null rate per column"]
    DQ --> DQ2["Missing-data matrix"]
    DQ --> DQ3["Bar: cross-system match rate per method"]
    DQ --> DQ4["Timeline: data coverage per source"]
